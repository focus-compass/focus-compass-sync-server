PORT=8080

# Published Docker image used by docker-compose (version + immutable digest)
FOCUS_COMPASS_IMAGE=ghcr.io/focus-compass/focus-compass-sync-server:v0.0.7

# Optional: strong random token.
# If omitted, the server starts in setup mode and the first visit to '/' can
# generate a token that will be persisted to ./data/auth.json.
ACCESS_TOKEN=

# Optional: MCP token (read-only MCP access via POST /mcp).
# If omitted, MCP starts disabled. Enable it from the admin UI (/) to generate
# a token that will be persisted to ./data/mcp-auth.json.
MCP_TOKEN=

DB_PATH=./data/db.sqlite
IMAGES_DIR=./data/images
BACKUP_DIR=./data/backups

# Optional: override auth file locations (advanced)
# AUTH_FILE_PATH=./data/auth.json
# MCP_AUTH_FILE_PATH=./data/mcp-auth.json

# 10 MiB
MAX_UPLOAD_BYTES=10485760

# Max Yjs document size decoded by REST/MCP read endpoints (bytes).
# Helps prevent OOM when inspecting very large documents.
MAX_DOC_DECODE_BYTES=134217728

# WebSocket/Yjs safety limits. Images are uploaded separately over HTTP and do
# not count against these limits.
# Max complete WebSocket message after fragmented frames are reassembled: 16 MiB.
MAX_WEBSOCKET_MESSAGE_BYTES=16777216
# Max buffered data/messages before one connection authenticates: 256 KiB / 32.
MAX_UNAUTHENTICATED_QUEUE_BYTES=262144
MAX_UNAUTHENTICATED_QUEUE_MESSAGES=32
# Max distinct document handshakes pending on one unauthenticated connection.
MAX_PENDING_DOCUMENTS=8
# Absolute pre-authentication deadline and authenticated idle timeout.
HOCUSPOCUS_TIMEOUT_MS=30000

# Comma-separated allowlist or '*' (default)
CORS_ALLOW_ORIGINS=*

# Default: true. Smaller docs, but full Yjs history is discarded.
YJS_GC=true

# Optional: GitHub repo used for update checks in the admin UI.
# Format: owner/repo
UPDATE_REPO=focus-compass/focus-compass-sync-server
