PORT=8080

# Host port mapping for docker-compose (optional)
HOCUSPOCUS_PORT=8080

# Optional: strong random token.
# If omitted, the server starts in setup mode and the first visit to '/' can
# generate a token that will be persisted to ./data/auth.json.
HOCUSPOCUS_TOKEN=

# Optional: MCP token (read-only MCP access via POST /mcp).
# If omitted, MCP starts disabled. Enable it from the admin UI (/) to generate
# a token that will be persisted to ./data/mcp-auth.json.
MCP_TOKEN=

DB_PATH=./data/db.sqlite
IMAGES_DIR=./data/images
BACKUP_DIR=./data/backups

# Optional: override auth file locations (advanced)
# AUTH_FILE_PATH=./data/auth.json
# MCP_AUTH_FILE_PATH=./data/mcp-auth.json

BACKUP_INTERVAL_MINUTES=60
BACKUP_RETENTION_DAYS=7

# 10 MiB
MAX_UPLOAD_BYTES=10485760

# Comma-separated allowlist or '*' (default)
CORS_ALLOW_ORIGINS=*

# Set to true to enable Yjs GC (smaller docs, less history)
YJS_GC=false

# Optional: GitHub repo used for update checks in the admin UI.
# Format: owner/repo
UPDATE_REPO=focus-compass/focus-compass-sync-server
