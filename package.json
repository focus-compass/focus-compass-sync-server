{
  "name": "focus-compass-server",
  "version": "0.0.2",
  "description": "WebSocket server for real-time collaboration based on Hocuspocus (CRDT/Yjs) with SQLite persistence",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "node tests/e2e-client.mjs",
    "test:docker-guide": "bash tests/test-docker-guide.sh",
    "test:install-script": "bash tests/test-install-script.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/focus-compass/focus-compass-sync-server.git"
  },
  "keywords": [
    "hocuspocus",
    "yjs",
    "crdt",
    "websocket",
    "collaboration",
    "sqlite",
    "realtime"
  ],
  "author": "Focus Masters",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/focus-compass/focus-compass-sync-server/issues"
  },
  "homepage": "https://github.com/focus-compass/focus-compass-sync-server#readme",
  "dependencies": {
    "@hocuspocus/extension-logger": "^3.4.0",
    "@hocuspocus/extension-sqlite": "^3.4.0",
    "@hocuspocus/server": "^3.4.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dotenv": "^17.2.3",
    "formidable": "^3.5.4",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.27",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@hocuspocus/provider": "^3.4.3",
    "eslint": "^9.6.0",
    "globals": "^17.1.0"
  }
}
